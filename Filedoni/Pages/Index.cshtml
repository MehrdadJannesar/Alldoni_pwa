@page
@model Filedoni.Pages.IndexModel
@{
    ViewData["Title"] = "File Storage";
}

<section class="file-shell">
    <header class="file-header">
        <div>
            <p class="eyebrow">ARVAN CLOUD FILE STORAGE</p>
            <h1>Filedoni</h1>
            <p class="subtitle">Keep important files available from one clean, private library.</p>
        </div>
        <form method="get" class="search-form">
            <input asp-for="Search" class="form-control" placeholder="Search titles, categories, descriptions, or file names" />
            <button class="btn btn-primary" type="submit">Search</button>
            <a class="btn btn-outline-secondary" asp-page="/Index">Reset</a>
        </form>
    </header>

    @if (!Model.StorageConfigured)
    {
        <div class="notice warning"><strong>Storage is not configured.</strong> Add the Arvan bucket and credentials using user-secrets or environment variables.</div>
    }
    @if (Model.ErrorMessage is not null) { <div class="notice error">@Model.ErrorMessage</div> }
    @if (TempData["Message"] is string message) { <div class="notice success">@message</div> }

    <div class="workspace">
        <aside class="upload-panel">
            <h2>Upload File</h2>
            <form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="Project brief" />
                <span asp-validation-for="Title" class="text-danger"></span>
                <label asp-for="Category" class="form-label"></label>
                <div class="category-autocomplete" data-categories='@System.Text.Json.JsonSerializer.Serialize(Model.Categories)'>
                    <input asp-for="Category" class="form-control category-input" autocomplete="off" placeholder="Documents" />
                    <div class="category-suggestions" role="listbox"></div>
                </div>
                <span asp-validation-for="Category" class="text-danger"></span>
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control description-input" rows="3" placeholder="Add a short description for this file"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
                <label asp-for="Upload" class="drop-zone" id="drop-zone">
                    <span class="upload-mark">+</span>
                    <strong id="file-label">Choose a file</strong>
                    <small>Maximum @Filedoni.Pages.IndexModel.FormatSize(Model.MaxUploadBytes)</small>
                </label>
                <input asp-for="Upload" type="file" hidden />
                <span asp-validation-for="Upload" class="text-danger"></span>
                <button class="btn btn-dark w-100" type="submit" disabled="@(!Model.StorageConfigured)">Upload</button>
            </form>
        </aside>

        <main>
            <div class="list-heading">
                <h2>Stored Files</h2>
                <span>@Model.Files.Count file@(Model.Files.Count == 1 ? "" : "s")</span>
            </div>
            @if (Model.StorageConfigured && Model.Files.Count == 0 && Model.ErrorMessage is null)
            {
                <div class="empty-state">No files found.</div>
            }
            <div class="file-list">
                @foreach (var file in Model.Files)
                {
                    <article class="file-card">
                        <div class="file-card-header">
                            <div class="file-details">
                                <span class="file-category">@file.Category</span>
                                <h3 class="file-title">sha256:@Model.Fingerprint(file.Title)</h3>
                                @if (!string.IsNullOrWhiteSpace(Model.Plain(file.Description))) { <p class="file-description">sha256:@Model.Fingerprint(file.Description)</p> }
                            </div>
                            <div class="actions">
                                <button class="btn btn-sm btn-outline-primary reveal-file" type="button" data-key="@file.Key">Reveal details</button>
                                <button class="btn btn-sm btn-outline-primary secure-download" type="button" data-key="@file.Key">Download</button>
                                <button class="btn btn-sm btn-outline-secondary edit-file" type="button"
                                        data-bs-toggle="modal" data-bs-target="#edit-file-modal"
                                        data-key="@file.Key" data-title="@Model.Plain(file.Title)"
                                        data-category="@file.Category" data-description="@Model.Plain(file.Description)">Edit</button>
                                <form method="post" asp-page-handler="Delete"
                                      data-delete-confirmation data-delete-name="@file.Title">
                                    <input type="hidden" name="key" value="@file.Key" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                </form>
                            </div>
                        </div>
                        <div class="file-object-meta">
                            <span class="file-extension">@System.IO.Path.GetExtension(file.FileName).TrimStart('.').ToUpperInvariant()</span>
                            <span class="file-name">sha256:@Model.Fingerprint(file.FileName)</span>
                            <span>@Filedoni.Pages.IndexModel.FormatSize(file.Size)</span>
                            <span>@(file.LastModified?.LocalDateTime.ToString("yyyy-MM-dd HH:mm") ?? "Unknown date")</span>
                        </div>
                    </article>
                }
            </div>
        </main>
    </div>

    <div class="modal fade" id="edit-file-modal" tabindex="-1" aria-labelledby="edit-file-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-page-handler="Edit">
                    <div class="modal-header">
                        <h2 class="modal-title" id="edit-file-title">Edit File Details</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body edit-fields">
                        <input asp-for="Edit!.Key" type="hidden" />
                        <label asp-for="Edit!.Title" class="form-label"></label>
                        <input asp-for="Edit!.Title" class="form-control" placeholder="Project brief" />
                        <span asp-validation-for="Edit!.Title" class="text-danger"></span>
                        <label asp-for="Edit!.Category" class="form-label"></label>
                        <div class="category-autocomplete" data-categories='@System.Text.Json.JsonSerializer.Serialize(Model.Categories)'>
                            <input asp-for="Edit!.Category" class="form-control category-input" autocomplete="off" placeholder="Documents" />
                            <div class="category-suggestions" role="listbox"></div>
                        </div>
                        <span asp-validation-for="Edit!.Category" class="text-danger"></span>
                        <label asp-for="Edit!.Description" class="form-label"></label>
                        <textarea asp-for="Edit!.Description" class="form-control description-input" rows="4" placeholder="Add a short description for this file"></textarea>
                        <span asp-validation-for="Edit!.Description" class="text-danger"></span>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-dark">Save changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.category-autocomplete').forEach(wrapper => {
            const input = wrapper.querySelector('.category-input');
            const suggestions = wrapper.querySelector('.category-suggestions');
            const categories = JSON.parse(wrapper.dataset.categories || '[]');

            const closeSuggestions = () => {
                suggestions.innerHTML = '';
                suggestions.classList.remove('is-open');
            };

            const termsMatch = (category, value) => {
                const terms = value.toLowerCase().split(/\s+/).filter(Boolean);
                const words = category.toLowerCase().split(/\s+/).filter(Boolean);
                return terms.length > 0 && terms.every(term =>
                    words.some(word => word.startsWith(term)) || category.toLowerCase().includes(term));
            };

            const renderSuggestions = () => {
                const matches = categories
                    .filter(category => termsMatch(category, input.value.trim()))
                    .slice(0, 6);
                suggestions.innerHTML = '';
                if (matches.length === 0) {
                    closeSuggestions();
                    return;
                }

                matches.forEach(category => {
                    const option = document.createElement('button');
                    option.type = 'button';
                    option.className = 'category-suggestion';
                    option.textContent = category;
                    option.addEventListener('click', () => {
                        input.value = category;
                        closeSuggestions();
                        input.focus();
                    });
                    suggestions.appendChild(option);
                });
                suggestions.classList.add('is-open');
            };

            input.addEventListener('input', renderSuggestions);
            input.addEventListener('focus', renderSuggestions);
            document.addEventListener('click', event => {
                if (!wrapper.contains(event.target)) closeSuggestions();
            });
        });

        const input = document.getElementById('Upload');
        const label = document.getElementById('file-label');
        input.addEventListener('change', () => label.textContent = input.files[0]?.name || 'Choose a file');

        document.querySelectorAll('.edit-file').forEach(button => {
            button.addEventListener('click', () => {
                document.getElementById('Edit_Key').value = button.dataset.key || '';
                document.getElementById('Edit_Title').value = button.dataset.title || '';
                document.getElementById('Edit_Category').value = button.dataset.category || '';
                document.getElementById('Edit_Description').value = button.dataset.description || '';
            });
        });

        document.querySelectorAll('.secure-download').forEach(button => {
            button.addEventListener('click', () => {
                const password = window.prompt('Enter the admin password to download this file:');
                if (!password) return;
                window.location.href = `?handler=Download&key=${encodeURIComponent(button.dataset.key)}&password=${encodeURIComponent(password)}`;
            });
        });

        async function revealFile(button) {
            const password = window.prompt('Enter the admin password to reveal these details:');
            if (!password) return;
            const response = await fetch('/api/files/reveal', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ key: button.dataset.key, password })
            });
            if (!response.ok) {
                window.alert('The password is incorrect or the file was not found.');
                return;
            }

            const item = await response.json();
            const card = button.closest('.file-card');
            card.querySelector('.file-title').textContent = item.title || '';
            const description = card.querySelector('.file-description');
            if (description) description.textContent = item.description || '';
            card.querySelector('.file-name').textContent = item.fileName || '';
            button.textContent = 'Revealed';
            button.disabled = true;
        }

        document.querySelectorAll('.reveal-file').forEach(button => {
            button.addEventListener('click', event => {
                event.preventDefault();
                event.stopPropagation();
                revealFile(button);
            });
        });

        @if (Model.OpenEditModal)
        {
            <text>bootstrap.Modal.getOrCreateInstance(document.getElementById('edit-file-modal')).show();</text>
        }
    </script>
}
