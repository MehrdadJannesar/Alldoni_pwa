<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Alldoni</title>
    <meta name="theme-color" content="#182238" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="topbar">
        <a class="brand" asp-page="/Index"><span>A</span> Alldoni</a>
    </nav>
    <main>@RenderBody()</main>
    <footer>
        <p>&copy; @DateTime.Now.ToString("yyyy") <a href="https://mehrdadjannesar.com/" target="_blank" rel="noopener noreferrer">Mehrdad Jannesar</a>. All Rights Reserved.</p>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
