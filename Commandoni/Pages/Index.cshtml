@page
@model IndexModel
@{
    ViewData["Title"] = "Command Library";
}

<section class="library-shell">
    <div class="library-header">
        <div>
            <p class="eyebrow">Personal Command Library</p>
            <h1>Commandoni</h1>
        </div>
        <form method="get" class="search-bar">
            <input asp-for="Search" class="form-control" placeholder="Search names, categories, or text" />
            <select asp-for="Category" class="form-select">
                <option value="">All categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
            <select asp-for="PageSize" class="form-select">
                @foreach (var pageSize in Model.PageSizes)
                {
                    <option value="@pageSize">@pageSize / page</option>
                }
            </select>
            <input type="hidden" name="PageNumber" value="1" />
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-page="/Index" class="btn btn-outline-secondary">Reset</a>
        </form>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }

    <div class="library-grid">
        <form method="post" class="snippet-form">
            <h2>@(Model.IsEditing ? "Edit Command" : "Add Command")</h2>
            @if (Model.IsEditing)
            {
                <input type="hidden" asp-for="EditId" />
                <input type="hidden" asp-for="Search" />
                <input type="hidden" asp-for="Category" />
                <input type="hidden" asp-for="PageNumber" />
                <input type="hidden" asp-for="PageSize" />
            }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" placeholder="Docker cleanup" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Category" class="form-label"></label>
                <div class="category-autocomplete" data-categories='@System.Text.Json.JsonSerializer.Serialize(Model.Categories)'>
                    <input asp-for="Input.Category" class="form-control category-input" autocomplete="off" placeholder="Programming" />
                    <div class="category-suggestions" role="listbox"></div>
                </div>
                <span asp-validation-for="Input.Category" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Description" class="form-label"></label>
                <textarea asp-for="Input.Description" class="form-control description-input" placeholder="What is this command for?"></textarea>
                <span asp-validation-for="Input.Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Content" class="form-label">Command or snippet</label>
                <textarea asp-for="Input.Content" class="form-control command-input" placeholder="Paste a command, script, note, or reusable text"></textarea>
                <span asp-validation-for="Input.Content" class="text-danger"></span>
            </div>
            <div class="form-actions">
                @if (Model.IsEditing)
                {
                    <button type="submit" asp-page-handler="Update" class="btn btn-dark">Update</button>
                    <a asp-page="/Index" asp-route-Search="@Model.Search" asp-route-Category="@Model.Category" asp-route-PageNumber="@Model.PageNumber" asp-route-PageSize="@Model.PageSize" class="btn btn-outline-secondary">Cancel</a>
                }
                else
                {
                    <button type="submit" asp-page-handler="Create" class="btn btn-dark">Save</button>
                }
            </div>
        </form>

        <section class="snippet-results" aria-label="Saved commands">
            <div class="results-meta">
                <h2>Saved Items</h2>
                <span>
                    @if (Model.TotalItems == 0)
                    {
                        @:0 items
                    }
                    else
                    {
                        @:@Model.FirstItemNumber-@Model.LastItemNumber of @Model.TotalItems
                    }
                </span>
            </div>

            @if (Model.Snippets.Count == 0)
            {
                <div class="empty-state">
                    No commands found. Add your first command or clear the filters.
                </div>
            }
            else
            {
                <div class="snippet-list">
                    @foreach (var snippet in Model.Snippets)
                    {
                        <article class="snippet-card">
                            <div class="snippet-card-header">
                                <div>
                                    <span class="category-pill">@snippet.Category</span>
                                    <h3>@snippet.Name</h3>
                                    @if (!string.IsNullOrWhiteSpace(Model.Plain(snippet.Description)))
                                    {
                                        <p class="snippet-description" id="snippet-description-@snippet.Id">sha256:@Model.Fingerprint(snippet.Description)</p>
                                    }
                                </div>
                                <div class="snippet-actions">
                                    <button type="button" class="btn btn-sm btn-outline-primary reveal-button" data-id="@snippet.Id" data-kind="command">
                                        Reveal details
                                    </button>
                                    <a class="btn btn-sm btn-outline-secondary" asp-page="/Index" asp-route-EditId="@snippet.Id" asp-route-Search="@Model.Search" asp-route-Category="@Model.Category" asp-route-PageNumber="@Model.PageNumber" asp-route-PageSize="@Model.PageSize">
                                        Edit
                                    </a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@snippet.Id" asp-route-Search="@Model.Search" asp-route-Category="@Model.Category" asp-route-PageNumber="@Model.PageNumber" asp-route-PageSize="@Model.PageSize"
                                          data-delete-confirmation data-delete-name="@snippet.Name">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </div>
                            <pre id="snippet-@snippet.Id"><code>sha256:@Model.Fingerprint(snippet.Content)</code></pre>
                        </article>
                    }
                </div>
            }

            @if (Model.TotalPages > 1)
            {
                <nav class="pagination-bar" aria-label="Command list pages">
                    <a class="btn btn-sm btn-outline-secondary @(Model.HasPreviousPage ? "" : "disabled")"
                       asp-page="/Index"
                       asp-route-Search="@Model.Search"
                       asp-route-Category="@Model.Category"
                       asp-route-PageNumber="@(Model.PageNumber - 1)"
                       asp-route-PageSize="@Model.PageSize">Previous</a>
                    <span>Page @Model.PageNumber of @Model.TotalPages</span>
                    <a class="btn btn-sm btn-outline-secondary @(Model.HasNextPage ? "" : "disabled")"
                       asp-page="/Index"
                       asp-route-Search="@Model.Search"
                       asp-route-Category="@Model.Category"
                       asp-route-PageNumber="@(Model.PageNumber + 1)"
                       asp-route-PageSize="@Model.PageSize">Next</a>
                </nav>
            }
        </section>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll(".category-autocomplete").forEach((wrapper) => {
            const input = wrapper.querySelector(".category-input");
            const suggestions = wrapper.querySelector(".category-suggestions");
            const categories = JSON.parse(wrapper.dataset.categories || "[]");

            const closeSuggestions = () => {
                suggestions.innerHTML = "";
                suggestions.classList.remove("is-open");
            };

            const termsMatch = (category, value) => {
                const terms = value.toLowerCase().split(/\s+/).filter(Boolean);
                const words = category.toLowerCase().split(/\s+/).filter(Boolean);

                return terms.length > 0 && terms.every((term) =>
                    words.some((word) => word.startsWith(term)) || category.toLowerCase().includes(term));
            };

            const renderSuggestions = () => {
                const value = input.value.trim();
                const matches = categories
                    .filter((category) => termsMatch(category, value))
                    .slice(0, 6);

                suggestions.innerHTML = "";
                if (matches.length === 0) {
                    closeSuggestions();
                    return;
                }

                matches.forEach((category) => {
                    const option = document.createElement("button");
                    option.type = "button";
                    option.className = "category-suggestion";
                    option.textContent = category;
                    option.addEventListener("click", () => {
                        input.value = category;
                        closeSuggestions();
                        input.focus();
                    });
                    suggestions.appendChild(option);
                });

                suggestions.classList.add("is-open");
            };

            input.addEventListener("input", renderSuggestions);
            input.addEventListener("focus", renderSuggestions);
            document.addEventListener("click", (event) => {
                if (!wrapper.contains(event.target)) {
                    closeSuggestions();
                }
            });
        });

        async function revealSnippet(button) {
            const password = window.prompt("Enter the admin password to reveal these details:");
            if (!password) return;
            const response = await fetch(`/api/snippets/${button.dataset.id}/reveal`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ password })
            });
            if (!response.ok) {
                window.alert("The password is incorrect or the item was not found.");
                return;
            }
            const item = await response.json();
            const content = document.getElementById(`snippet-${button.dataset.id}`);
            const description = document.getElementById(`snippet-description-${button.dataset.id}`);
            if (description) description.textContent = item.description || "";
            content.textContent = item.content || "";
            button.textContent = "Revealed";
            button.disabled = true;
        }

        document.querySelectorAll(".reveal-button").forEach((button) => {
            button.addEventListener("click", (event) => {
                event.preventDefault();
                event.stopPropagation();
                revealSnippet(button);
            });
        });

        document.querySelectorAll(".copy-button").forEach((button) => {
            button.addEventListener("click", async () => {
                const target = document.getElementById(button.dataset.copyTarget);
                const originalText = button.textContent;

                try {
                    await navigator.clipboard.writeText(target.textContent.trim());
                    button.textContent = "Copied";
                    button.classList.replace("btn-outline-primary", "btn-success");
                } catch {
                    button.textContent = "Failed";
                    button.classList.replace("btn-outline-primary", "btn-danger");
                }

                window.setTimeout(() => {
                    button.textContent = originalText;
                    button.classList.remove("btn-success", "btn-danger");
                    button.classList.add("btn-outline-primary");
                }, 1400);
            });
        });
    </script>
}
